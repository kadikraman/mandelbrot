test "a click zooms in, and in zoom-out mode the same click zooms back out"
  expect tree has "set"
  tap "set"
  clock +1000
  expect text "zoom" == "4×"
  tap "mode-out"
  tap "set"
  clock +1000
  expect text "zoom" == "1×"

test "the explainer switches levels, opens the code and the facts, and hides"
  size 1440x900
  clock data
  expect tree missing "explainer"
  tap "show"
  expect text "explainer-title" == "Why is it cool?"
  expect tree has "level-five"
  expect tree missing "code"
  tap "pick-some"
  expect tree has "level-some"
  expect tree has "steps"
  tap "code"
  expect tree has "code"
  tap "pick-pro"
  expect tree has "level-pro"
  tap "maths"
  expect tree has "maths"
  tap "hide"
  expect tree missing "explainer"
  tap "show"
  expect tree has "level-pro"

test "the Colours menu picks a theme"
  size 1440x900
  clock data
  expect tree has "chosen-warm"
  tap "colours"
  tap "theme-magma"
  expect tree has "chosen-magma"
  expect tree missing "chosen-warm"

test "the steps slider caps the picture, and Reset gives back full detail"
  size 1440x900
  clock data
  tap "show"
  tap "pick-some"
  expect text "steps-value" == "Full detail"
  type "steps" "40"
  expect text "steps-value" == "40"
  tap "steps-reset"
  expect text "steps-value" == "Full detail"
  expect tree missing "steps-reset"
