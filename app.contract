// A full-screen Mandelbrot canvas with an explainer beside it. A click zooms
// in or out, as the toggle says; Option-click and right-click zoom the other
// way. Below 720 points wide the explainer is a sheet; without WebGPU the page
// is a reading layout.
shape View
  zoom: number
  zoomLabel: string
  deepest: bool
  sharp: number
  presented: bool

shape Viewport
  width: number
  height: number

shape Run
  id: string
  text: string
  kind: string

shape Para
  id: string
  runs: Run[]

shape CodeLine
  id: string
  indent: number
  runs: Run[]

shape Claim
  id: string
  stmt: Run[]
  why: Run[]

shape Source
  id: string
  text: string
  href: string

shape Chapter
  id: string
  number: number
  title: string
  formula: string
  paras: Para[]
  control: string
  codeFile: string
  codeLang: string
  code: CodeLine[]
  claims: Claim[]
  sources: Source[]

// The design's tokens (Expo's dark theme).
style Glass
  background-color = "rgba(11, 15, 20, 0.86)"
  backdrop-filter = "blur(16px) saturate(140%)"
  border = "1px solid rgba(255, 255, 255, 0.10)"
  border-radius = 12
  box-shadow = "0 8px 30px rgba(0, 0, 0, 0.6)"
  color = "#e6edf3"

style Btn
  appearance = "none"
  display = "flex"
  flex-direction = "row"
  align-items = "center"
  justify-content = "center"
  gap = 6
  height = 32
  min-width = 32
  padding = "0 10px"
  border-radius = 6
  background-color = "transparent"
  color = "#e6edf3"
  font-size = 13
  font-weight = 500
  white-space = "nowrap"
  transition = "background-color 180ms cubic-bezier(0.4, 0, 0.2, 1), color 180ms cubic-bezier(0.4, 0, 0.2, 1)"
  :hover
    background-color = "rgba(255, 255, 255, 0.08)"
  :checked
    background-color = "rgba(255, 255, 255, 0.14)"
    box-shadow = "inset 0 0 0 1px rgba(255, 255, 255, 0.22)"
  :focus-visible
    box-shadow = "0 0 0 2px #4aa8ff"

style Seg
  appearance = "none"
  display = "flex"
  flex-direction = "row"
  align-items = "center"
  justify-content = "center"
  gap = 6
  height = 28
  padding = "0 10px"
  border-radius = 6
  background-color = "transparent"
  color = "#9aa4ae"
  font-size = 13
  font-weight = 500
  white-space = "nowrap"
  transition = "background-color 180ms cubic-bezier(0.4, 0, 0.2, 1), color 180ms cubic-bezier(0.4, 0, 0.2, 1)"
  :hover
    background-color = "rgba(255, 255, 255, 0.08)"
    color = "#e6edf3"
  :checked
    background-color = "#e6edf3"
    color = "#0b0f14"
    box-shadow = "0 1px 2px rgba(0, 0, 0, 0.5)"
  :focus-visible
    box-shadow = "0 0 0 2px #4aa8ff"

style Divider
  width = 1
  height = 20
  background-color = "rgba(255, 255, 255, 0.22)"
  margin = "0 4px"
  flex-shrink = 0

style Secondary
  color = "#9aa4ae"

style Mono
  font-family = "ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace"

style MathFont
  font-family = "ui-serif, 'Iowan Old Style', Georgia, 'Times New Roman', serif"

style Eyebrow
  font-family = "ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace"
  font-size = 12
  font-weight = 500
  letter-spacing = 0.5
  text-transform = "uppercase"
  color = "#9aa4ae"

style Para
  font-size = 15
  line-height = 1.55

style Disclosure
  appearance = "none"
  display = "flex"
  flex-direction = "row"
  align-items = "center"
  gap = 10
  min-height = 44
  padding = "0 4px"
  border-radius = 6
  background-color = "transparent"
  color = "#e6edf3"
  font-size = 15
  font-weight = 500
  :hover
    background-color = "rgba(255, 255, 255, 0.08)"
  :focus-visible
    box-shadow = "0 0 0 2px #4aa8ff"

style Well
  display = "flex"
  flex-direction = "column"
  gap = 10
  padding = 12
  border-radius = 8
  background-color = "rgba(255, 255, 255, 0.06)"
  box-shadow = "inset 0 0 0 1px rgba(255, 255, 255, 0.10)"

style TocItem
  appearance = "none"
  display = "flex"
  flex-direction = "row"
  align-items = "center"
  gap = 12
  min-height = 40
  padding = "8px 10px"
  border-radius = 6
  background-color = "transparent"
  color = "#e6edf3"
  font-size = 15
  text-align = "left"
  :hover
    background-color = "rgba(255, 255, 255, 0.08)"
  :checked
    background-color = "rgba(255, 255, 255, 0.14)"
  :focus-visible
    box-shadow = "0 0 0 2px #4aa8ff"

fn titleAt(chapters: Chapter[], i: number): string = match chapters.at(i) { case some(c) => c.title, case none => "" }


component Mandelbrot
  resource view = exactSurface("mandel") as shape View
  resource viewport = exactViewport() as shape Viewport
  resource chapters = chapters() as shape Chapter[] else empty()
  state zoomOut = false
  state showBox = false
  state chapter = 0
  state explainerOpen = false
  state contentsOpen = false
  state sheet = 0
  state codeOpen: number[] = []
  state mathsOpen: number[] = []
  // Chapter 1's slider caps the iterations once the reader moves it, while chapter 1 shows.
  state steps = 12
  state stepsMoved = false
  state noGpu = false
  derive phone = viewport.width < 720
  derive current = chapters.at(chapter)
  derive capped = stepsMoved and chapter == 0 and (phone ? sheet > 0 : explainerOpen)
  task gpuCheck mount
    after(5000, checkGpu)
  action checkGpu
    noGpu = not view.presented
  action pick(out: bool)
    zoomOut = out
  action toggleBox
    showBox = not showBox
  action reset
    postMessage("reset", "mandel")
  action hovered(on: bool)
    if not on
      postMessage("hover-off", "mandel")
  action go(n: number)
    chapter = n
    contentsOpen = false
  action toggleExplainer
    explainerOpen = not explainerOpen
  action toggleContents
    contentsOpen = not contentsOpen
  action setSheet(h: number)
    sheet = h
  action toggleCode(n: number)
    codeOpen = codeOpen.includes(n) ? codeOpen.filter(x => x != n) : codeOpen.concat([n])
  action toggleMaths(n: number)
    mathsOpen = mathsOpen.includes(n) ? mathsOpen.filter(x => x != n) : mathsOpen.concat([n])
  action setSteps(v: number)
    steps = v
    stepsMoved = true
  action key(k: string)
    if k == "e" or k == "E"
      explainerOpen = not explainerOpen
    if k == "+" or k == "="
      postMessage("zoom-in", "mandel")
    if k == "-" or k == "_"
      postMessage("zoom-out", "mandel")
    if k == "ArrowLeft"
      postMessage("pan 80 0", "mandel")
    if k == "ArrowRight"
      postMessage("pan -80 0", "mandel")
    if k == "ArrowUp"
      postMessage("pan 0 80", "mandel")
    if k == "ArrowDown"
      postMessage("pan 0 -80", "mandel")
  view
    main testId="root" width="100%" height="100%" position="relative" overflow="hidden" background-color="#000000" color="#e6edf3" color-scheme="dark" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" key=key
      canvas surface=mandel(maxIter=(capped ? steps : 0), zoomOut=zoomOut, iterScale=1, bla=true, hoverBox=showBox, freeRight=((not phone and explainerOpen) ? 432 : 0)) hover=hovered cursor=(zoomOut ? "zoom-out" : "zoom-in") position="absolute" inset=0 width="100%" height="100%" aria-label="The Mandelbrot set" role="img" testId="set"
      if noGpu
        NoGpu(chapters=chapters, chapter=chapter, go=go, codeOpen=codeOpen, mathsOpen=mathsOpen, toggleCode=toggleCode, toggleMaths=toggleMaths, phone=phone)
      else if phone
        PhoneUi(view=view, height=viewport.height, chapters=chapters, chapter=chapter, go=go, zoomOut=zoomOut, pick=pick, showBox=showBox, toggleBox=toggleBox, reset=reset, sheet=sheet, setSheet=setSheet, codeOpen=codeOpen, mathsOpen=mathsOpen, toggleCode=toggleCode, toggleMaths=toggleMaths, steps=steps, setSteps=setSteps)
      else
        column class=Glass position="absolute" left=16 bottom=16 testId="explore"
          row align-items="center" gap=4 padding=6
            row gap=2 padding=2 border-radius=8 background-color="rgba(255, 255, 255, 0.06)" box-shadow="inset 0 0 0 1px rgba(255, 255, 255, 0.10)" role="radiogroup" aria-label="Click to"
              button class=Seg role="radio" aria-checked=(not zoomOut) press=pick(false) testId="mode-in"
                Icon(name="zoom-in", size=16)
                text "Zoom in"
              button class=Seg role="radio" aria-checked=zoomOut press=pick(true) testId="mode-out"
                Icon(name="zoom-out", size=16)
                text "Zoom out"
            view class=Divider
            row align-items="center" gap=8 height=32 padding="0 8px" min-width=168
              if view.sharp < 16
                Ring(passes=view.sharp)
              else
                view width=16 height=16 flex-shrink=0
              text "Zoom" class=Secondary font-size=13
              text `${view.zoomLabel}×` class=Mono font-size=13 font-weight=500 font-variant-numeric="tabular-nums" testId="zoom"
            view class=Divider
            button class=Btn press=reset testId="reset"
              Icon(name="reset", size=16)
              text "Reset"
            button class=Btn aria-pressed=(showBox ? "true" : "false") press=toggleBox testId="box"
              Icon(name="box", size=16)
              text "Zoom box"
          if view.deepest
            text "This is the deepest zoom. The GPU's 32-bit numbers cannot go further, so zoom out or pan." font-size=12 line-height=1.3 padding="0 12px 8px" color="#ffb86b" role="status" testId="deepest"
          else
            text `Click zooms ${zoomOut ? "out" : "in"} 4×. Option-click or right-click zooms the other way.` class=Secondary font-size=12 line-height=1.3 padding="0 12px 8px"
          text (view.sharp < 16 ? `Sharpening: pass ${view.sharp + 1} of 16` : "") role="status" position="absolute" width=1 height=1 overflow="hidden" opacity=0
        if explainerOpen
          column class=Glass position="absolute" top=16 right=16 bottom=16 width=400 overflow="hidden" testId="explainer"
            column gap=10 padding="12px 12px 0 16px"
              row align-items="center" gap=4
                row flex=1 align-items="baseline" gap=8
                  text "Mandelbrot" font-size=15 font-weight=600
                  text "7 chapters" class=Secondary font-size=12
                button class=Btn aria-pressed=(contentsOpen ? "true" : "false") press=toggleContents color="#9aa4ae" testId="contents"
                  Icon(name="list", size=16)
                  text "Contents"
                button class=Btn press=toggleExplainer color="#9aa4ae" aria-keyshortcuts="E" testId="hide"
                  Icon(name="panel", size=16)
                  text "Hide"
                  text "E" class=Mono font-size=11 padding="0 5px" height=18 line-height="18px" border-radius=4 box-shadow="inset 0 0 0 1px rgba(255, 255, 255, 0.22)"
              Stepper(count=chapters.length, chapter=chapter, go=go, tall=false)
            scroll flex=1 min-height=0 padding="20px 20px 24px"
              if contentsOpen
                column gap=2
                  text "Contents" class=Eyebrow margin-bottom=12
                  for c in chapters key=c.id
                    button class=TocItem aria-checked=(c.number - 1 == chapter) press=go(c.number - 1)
                      text `${c.number}` class=Mono font-size=12 color="#9aa4ae" width=16
                      text c.title
              else
                match current
                  case some(ch)
                    ChapterView(ch=ch, total=chapters.length, codeOpen=codeOpen.includes(chapter), mathsOpen=mathsOpen.includes(chapter), toggleCode=toggleCode(chapter), toggleMaths=toggleMaths(chapter), steps=steps, setSteps=setSteps, live=true, heading=true)
                  case none
                    text ""
            row justify-content="space-between" align-items="center" padding="10px 12px" border-top="1px solid rgba(255, 255, 255, 0.10)"
              button class=Btn press=go(chapter - 1) disabled=(chapter == 0) color="#9aa4ae" testId="previous"
                Icon(name="left", size=16)
                text "Previous"
              if chapter + 1 < chapters.length
                button class=Btn press=go(chapter + 1) box-shadow="inset 0 0 0 1px rgba(255, 255, 255, 0.22)" testId="next"
                  text `Next: ${titleAt(chapters, chapter + 1)}`
                  Icon(name="right", size=16)
        else
          row class=Glass position="absolute" top=16 right=16 padding=4
            button class=Btn height=36 padding="0 10px" press=toggleExplainer aria-keyshortcuts="E" testId="show"
              Icon(name="book", size=16)
              text "Explainer"
              text `${chapter + 1}/${chapters.length}` class=Mono font-size=12 color="#9aa4ae"
              text "E" class=Mono font-size=11 padding="0 5px" height=18 line-height="18px" border-radius=4 box-shadow="inset 0 0 0 1px rgba(255, 255, 255, 0.22)" color="#9aa4ae"

// The Lucide icon of that name, in the current colour.
component Icon
  props
    name: string
    size: number
  view
    svg width=size height=size viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0
      if name == "zoom-in" or name == "zoom-out"
        circle cx=11 cy=11 r=8
        path d="m21 21-4.35-4.35"
        path d="M8 11h6"
        if name == "zoom-in"
          path d="M11 8v6"
      if name == "reset"
        path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"
        path d="M3 3v5h5"
      if name == "box"
        path d="M3 7V5a2 2 0 0 1 2-2h2"
        path d="M17 3h2a2 2 0 0 1 2 2v2"
        path d="M21 17v2a2 2 0 0 1-2 2h-2"
        path d="M7 21H5a2 2 0 0 1-2-2v-2"
      if name == "list"
        path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"
      if name == "panel"
        rect x=3 y=3 width=18 height=18 rx=2
        path d="M15 3v18"
      if name == "book"
        path d="M12 7v14"
        path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"
      if name == "left"
        path d="m15 18-6-6 6-6"
      if name == "right"
        path d="m9 18 6-6-6-6"
      if name == "down"
        path d="m6 9 6 6 6-6"
      if name == "up"
        path d="m18 15-6-6-6 6"
      if name == "code"
        path d="m16 18 6-6-6-6"
        path d="m8 6-6 6 6 6"
      if name == "sigma"
        path d="M18 7V5a1 1 0 0 0-1-1H6.5a.5.5 0 0 0-.4.8l4.5 6a2 2 0 0 1 0 2.4l-4.5 6a.5.5 0 0 0 .4.8H17a1 1 0 0 0 1-1v-2"
      if name == "no-gpu"
        path d="M17 17H4a2 2 0 0 1-2-2V5c0-1.5 1-2 1-2"
        path d="M22 15V5a2 2 0 0 0-2-2H9"
        path d="M8 21h8M12 17v4M2 2l20 20"

// The sharpening ring: one sixteenth of the circle per pass.
component Ring
  props
    passes: number
  view
    svg width=16 height=16 viewBox="0 0 16 16" fill="none" flex-shrink=0 transform="rotate(-90deg)"
      circle cx=8 cy=8 r=6 stroke="rgba(255, 255, 255, 0.22)" stroke-width=2
      circle cx=8 cy=8 r=6 stroke="#e6edf3" stroke-width=2 stroke-dasharray="37.7" stroke-dashoffset=(37.7 * (1 - passes / 16)) transition="stroke-dashoffset 120ms linear"

// Prose with maths in serif italics, bold and inline code.
component Runs
  props
    runs: Run[]
  view
    for r in runs key=r.id
      if r.kind == "math"
        text r.text class=MathFont font-style="italic" font-size="1.07em"
      else if r.kind == "strong"
        text r.text font-weight=600
      else if r.kind == "code"
        text r.text class=Mono font-size="0.87em" background-color="rgba(255, 255, 255, 0.06)" border-radius=4 padding="2px 5px"
      else
        text r.text

// One chapter: its plain tier, its control, and the code and maths tiers.
component ChapterView
  props
    ch: Chapter
    total: number
    codeOpen: bool
    mathsOpen: bool
    toggleCode: action
    toggleMaths: action
    steps: number
    setSteps: action
    live: bool
    // The phone's sheet shows the chapter's number and title in its own header.
    heading: bool
  view
    article display="flex" flex-direction="column" gap=16 aria-label=`Chapter ${ch.number}`
      if heading
        text `Chapter ${ch.number} of ${total}` class=Eyebrow
      text ch.title role="heading" aria-level=2 font-size=22 font-weight=600 line-height=1.2 letter-spacing=-0.4 display=(heading ? "block" : "none") testId="chapter-title"
      if ch.formula != ""
        text ch.formula class=MathFont font-style="italic" font-size=30 text-align="center" padding="14px 0" border-top="1px solid rgba(255, 255, 255, 0.10)" border-bottom="1px solid rgba(255, 255, 255, 0.10)"
      for p in ch.paras key=p.id
        text class=Para
          Runs(runs=p.runs)
      if ch.control == "steps"
        column class=Well
          row justify-content="space-between"
            text "Steps to try" font-size=13 font-weight=500
            text `${steps}` class=Mono font-size=13 font-variant-numeric="tabular-nums"
          input type="range" min=1 max=200 step=1 value=steps accent-color="#e6edf3" input=setSteps disabled=(not live) aria-label="Steps to try" testId="steps"
          text (live ? "Few steps give a blobby outline. More steps carve the edge. Watch the picture change as you drag." : "Needs the live picture. You can still read on.") class=Secondary font-size=12 line-height=1.4
      if ch.control == "pin"
        column class=Well
          text "Coming soon: the orbit of the point under the pointer, drawn on the picture." class=Secondary font-size=12 line-height=1.4
      if ch.code.length > 0
        column border-top="1px solid rgba(255, 255, 255, 0.10)"
          column border-bottom="1px solid rgba(255, 255, 255, 0.10)" padding-bottom=(codeOpen ? 16 : 0) gap=12
            button class=Disclosure press=toggleCode aria-expanded=codeOpen testId="code"
              row width=24 height=24 align-items="center" justify-content="center" border-radius=4 box-shadow="inset 0 0 0 1px rgba(255, 255, 255, 0.22)" class=Secondary
                Icon(name="code", size=14)
              text (codeOpen ? "Hide the code" : "Show the code") flex=1 text-align="left"
              text ch.codeLang class=Mono font-size=12 color="#9aa4ae"
              row class=Secondary
                Icon(name=(codeOpen ? "up" : "down"), size=16)
            if codeOpen
              column border-radius=8 background-color="#0f1318" box-shadow="inset 0 0 0 1px #1f242c" overflow="hidden"
                row height=32 align-items="center" padding="0 12px" border-bottom="1px solid #1f242c"
                  text ch.codeFile class=Mono font-size=12 color="#9aa4ae"
                column padding="12px 14px" overflow-x="auto"
                  for l in ch.code key=l.id
                    text class=Mono font-size=12.5 line-height=1.6 white-space="pre" min-height=20 padding-left=`${l.indent * 2}ch`
                      for r in l.runs key=r.id
                        if r.kind == "c"
                          text r.text color="#9aa4ae" font-style="italic"
                        else if r.kind == "k"
                          text r.text color="#ff9bd2"
                        else if r.kind == "n"
                          text r.text color="#ffd36b"
                        else if r.kind == "f"
                          text r.text color="#7cc4ff"
                        else
                          text r.text
          column border-bottom="1px solid rgba(255, 255, 255, 0.10)" padding-bottom=(mathsOpen ? 16 : 0) gap=12
            button class=Disclosure press=toggleMaths aria-expanded=mathsOpen testId="maths"
              row width=24 height=24 align-items="center" justify-content="center" border-radius=4 box-shadow="inset 0 0 0 1px rgba(255, 255, 255, 0.22)" class=Secondary
                Icon(name="sigma", size=14)
              text (mathsOpen ? "Hide the maths" : "Show the maths") flex=1 text-align="left"
              text `${ch.claims.length} ${ch.claims.length == 1 ? "fact" : "facts"}` class=Mono font-size=12 color="#9aa4ae"
              row class=Secondary
                Icon(name=(mathsOpen ? "up" : "down"), size=16)
            if mathsOpen
              column gap=14
                for c in ch.claims key=c.id
                  row gap=8
                    text c.id.slice(1) class=Mono font-size=12 color="#9aa4ae" width=20 line-height=1.9 flex-shrink=0
                    column gap=4 flex=1 min-width=0
                      text font-weight=500 class=Para
                        Runs(runs=c.stmt)
                      text font-size=13 line-height=1.5 color="#9aa4ae"
                        Runs(runs=c.why)
                text "Sources" class=Eyebrow
                column gap=6
                  for s in ch.sources key=s.id
                    if s.href != ""
                      link href=s.href font-size=13 color="#4aa8ff" text-decoration="underline"
                        text s.text
                    else
                      text s.text font-size=13

// Seven segments, one per chapter; the current one is white.
component Stepper
  props
    count: number
    chapter: number
    go: action
    tall: bool
  view
    nav display="flex" flex-direction="row" gap=4 aria-label="Chapters"
      for i in range(count) key=i
        button appearance="none" flex=1 height=(tall ? 44 : 20) padding=0 background-color="transparent" display="flex" align-items="center" press=go(i) aria-current=(i == chapter ? "step" : "false") aria-label=`Chapter ${i + 1}` testId=`step-${i + 1}`
          view width="100%" height=4 border-radius=2 background-color=(i == chapter ? "#e6edf3" : "rgba(255, 255, 255, 0.22)")

// The phone: a zoom chip, a dock of icon buttons, and the explainer as a sheet
// at three heights (0 peek, 1 half, 2 full).
component PhoneUi
  props
    view: View
    height: number
    chapters: Chapter[]
    chapter: number
    go: action
    zoomOut: bool
    pick: action
    showBox: bool
    toggleBox: action
    reset: action
    sheet: number
    setSheet: action
    codeOpen: number[]
    mathsOpen: number[]
    toggleCode: action
    toggleMaths: action
    steps: number
    setSteps: action
  derive sheetHeight = sheet == 0 ? 76 : sheet == 1 ? 420 : min(772, height - 72)
  derive current = chapters.at(chapter)
  view
    column class=Glass position="absolute" top=12 left=12 gap=4 padding="8px 12px 9px" testId="chip"
      row align-items="center" gap=8
        if view.sharp < 16
          Ring(passes=view.sharp)
        text "Zoom" class=Secondary font-size=13
        text `${view.zoomLabel}×` class=Mono font-size=13 font-weight=500 font-variant-numeric="tabular-nums" testId="zoom"
      if view.deepest
        text "Deepest zoom: zoom out or pan" font-size=12 color="#ffb86b" role="status" testId="deepest"
      else
        text `Tap zooms ${zoomOut ? "out" : "in"} 4×` class=Secondary font-size=12
    if sheet < 2
      row class=Glass position="absolute" left="50%" translate="-50% 0" bottom=(sheetHeight + 12) align-items="center" gap=4 padding=4 border-radius=14 testId="dock"
        row gap=2 padding=2 border-radius=10 background-color="rgba(255, 255, 255, 0.06)" role="radiogroup" aria-label="Tap to"
          button class=Seg width=44 height=40 padding=0 role="radio" aria-checked=(not zoomOut) press=pick(false) aria-label="Zoom in" testId="mode-in"
            Icon(name="zoom-in", size=20)
          button class=Seg width=44 height=40 padding=0 role="radio" aria-checked=zoomOut press=pick(true) aria-label="Zoom out" testId="mode-out"
            Icon(name="zoom-out", size=20)
        view class=Divider
        button class=Btn width=44 height=44 padding=0 press=reset aria-label="Reset" testId="reset"
          Icon(name="reset", size=20)
        button class=Btn width=44 height=44 padding=0 aria-pressed=(showBox ? "true" : "false") press=toggleBox aria-label="Zoom box" testId="box"
          Icon(name="box", size=20)
    column class=Glass position="absolute" left=0 right=0 bottom=0 height=sheetHeight border-radius="16px 16px 0 0" overflow="hidden" transition="height 180ms cubic-bezier(0.4, 0, 0.2, 1)" testId="sheet"
      button appearance="none" height=20 background-color="transparent" display="flex" justify-content="center" press=setSheet(sheet == 1 ? 2 : 1) aria-label=(sheet == 1 ? "Expand the explainer" : "Open the explainer") testId="grab"
        view width=36 height=5 border-radius=3 margin-top=6 background-color="rgba(255, 255, 255, 0.22)"
      if sheet == 0
        button appearance="none" background-color="transparent" color="#e6edf3" display="flex" flex-direction="row" align-items="center" gap=8 padding="0 16px" min-height=44 text-align="left" press=setSheet(1) testId="peek"
          column flex=1 gap=4
            text `Chapter ${chapter + 1} of ${chapters.length}` class=Eyebrow
            text titleAt(chapters, chapter) font-size=17 font-weight=600
          Icon(name="up", size=20)
      else
        row align-items="center" gap=4 padding="0 8px" min-height=52
          button class=Btn width=44 height=44 padding=0 press=go(chapter - 1) disabled=(chapter == 0) aria-label="Previous chapter" testId="previous"
            Icon(name="left", size=20)
          column flex=1 min-width=0 gap=4
            text `Chapter ${chapter + 1} of ${chapters.length}` class=Eyebrow
            text titleAt(chapters, chapter) font-size=17 font-weight=600 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          button class=Btn width=44 height=44 padding=0 press=go(chapter + 1) disabled=(chapter + 1 >= chapters.length) aria-label="Next chapter" testId="next"
            Icon(name="right", size=20)
          button class=Btn width=44 height=44 padding=0 press=setSheet(0) aria-label="Collapse the explainer" testId="collapse"
            Icon(name="down", size=20)
        column padding="0 16px"
          Stepper(count=chapters.length, chapter=chapter, go=go, tall=true)
        scroll flex=1 min-height=0 padding="8px 16px 24px"
          match current
            case some(ch)
              ChapterView(ch=ch, total=chapters.length, codeOpen=codeOpen.includes(chapter), mathsOpen=mathsOpen.includes(chapter), toggleCode=toggleCode(chapter), toggleMaths=toggleMaths(chapter), steps=steps, setSteps=setSteps, live=true, heading=false)
            case none
              text ""

// Without WebGPU the page is for reading: the chapters beside a notice, and
// the controls that need the picture disabled.
component NoGpu
  props
    chapters: Chapter[]
    chapter: number
    go: action
    codeOpen: number[]
    mathsOpen: number[]
    toggleCode: action
    toggleMaths: action
    phone: bool
  derive current = chapters.at(chapter)
  view
    scroll position="absolute" inset=0 background-color="#0b0f14" testId="reader"
      row justify-content="center" gap=48 padding=(phone ? "16px" : "40px 24px")
        if not phone
          nav display="flex" flex-direction="column" width=240 flex-shrink=0 gap=2 aria-label="Chapters"
            text "Mandelbrot" font-size=15 font-weight=600 padding="0 10px"
            text "an explainer in 7 chapters" class=Secondary font-size=12 padding="0 10px" margin-bottom=12
            for c in chapters key=c.id
              button class=TocItem aria-checked=(c.number - 1 == chapter) press=go(c.number - 1)
                text `${c.number}` class=Mono font-size=12 color="#9aa4ae" width=16
                text c.title
        column flex=1 max-width=640 min-width=0 gap=20
          row gap=12 align-items="flex-start" padding="14px 16px" border-radius=12 background-color="#161a20" box-shadow="inset 0 0 0 1px #30363d" testId="no-webgpu"
            row width=32 height=32 flex-shrink=0 align-items="center" justify-content="center" border-radius=8 background-color="rgba(33, 136, 255, 0.18)" color="#4aa8ff"
              Icon(name="no-gpu", size=18)
            column gap=4 flex=1
              text "This browser can’t draw the live picture" role="heading" aria-level=2 font-size=15 font-weight=600
              text "The live picture needs WebGPU. Try a recent version of Chrome or Edge on a desktop computer. Everything else on this page still works: the text, the code and the maths." class=Secondary font-size=13 line-height=1.5
          match current
            case some(ch)
              ChapterView(ch=ch, total=chapters.length, codeOpen=codeOpen.includes(chapter), mathsOpen=mathsOpen.includes(chapter), toggleCode=toggleCode(chapter), toggleMaths=toggleMaths(chapter), steps=12, setSteps=go, live=false, heading=true)
            case none
              text ""
          row justify-content="space-between" padding-top=16 border-top="1px solid rgba(255, 255, 255, 0.10)"
            button class=Btn press=go(chapter - 1) disabled=(chapter == 0) color="#9aa4ae"
              Icon(name="left", size=16)
              text "Previous"
            if chapter + 1 < chapters.length
              button class=Btn press=go(chapter + 1) box-shadow="inset 0 0 0 1px rgba(255, 255, 255, 0.22)"
                text `Next: ${titleAt(chapters, chapter + 1)}`
                Icon(name="right", size=16)
