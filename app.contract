// A full-screen Mandelbrot canvas with an explainer beside it. A click zooms
// in or out, as the toggle says; Option-click and right-click zoom the other
// way. Below 720 points wide the explainer is a sheet; without WebGPU the page
// is a reading layout.
shape View
  zoom: number
  zoomLabel: string
  deepest: bool
  sharp: number
  presented: bool

shape Viewport
  width: number
  height: number
  prefersReducedMotion: bool

shape Run
  id: string
  text: string
  kind: string

shape Para
  id: string
  runs: Run[]

shape CodeLine
  id: string
  indent: number
  runs: Run[]

shape Claim
  id: string
  stmt: Run[]
  why: Run[]

shape Source
  id: string
  text: string
  href: string

shape Theme
  id: string
  index: number
  name: string
  swatch: string

shape Section
  id: string
  title: string
  paras: Para[]

shape Level
  id: string
  index: number
  label: string
  formula: string
  sections: Section[]
  control: string
  codeFile: string
  codeLang: string
  code: CodeLine[]
  claims: Claim[]
  sources: Source[]

// The design's tokens (Expo's dark theme).
style Glass
  background-color = "rgba(11, 15, 20, 0.86)"
  backdrop-filter = "blur(16px) saturate(140%)"
  border = "1px solid rgba(255, 255, 255, 0.10)"
  border-radius = 12
  box-shadow = "0 8px 30px rgba(0, 0, 0, 0.6)"
  color = "#e6edf3"

style Btn
  appearance = "none"
  display = "flex"
  flex-direction = "row"
  align-items = "center"
  justify-content = "center"
  gap = 6
  height = 32
  min-width = 32
  padding = "0 10px"
  border-radius = 6
  background-color = "transparent"
  color = "#e6edf3"
  font-size = 13
  font-weight = 500
  white-space = "nowrap"
  cursor = "pointer"
  transition = "background-color 180ms cubic-bezier(0.4, 0, 0.2, 1), color 180ms cubic-bezier(0.4, 0, 0.2, 1)"
  :hover
    background-color = "rgba(255, 255, 255, 0.08)"
  :checked
    background-color = "rgba(255, 255, 255, 0.14)"
    box-shadow = "inset 0 0 0 1px rgba(255, 255, 255, 0.22)"
  :focus-visible
    box-shadow = "0 0 0 2px #4aa8ff"

style Seg
  appearance = "none"
  display = "flex"
  flex-direction = "row"
  align-items = "center"
  justify-content = "center"
  gap = 6
  height = 28
  padding = "0 10px"
  border-radius = 6
  background-color = "transparent"
  color = "#9aa4ae"
  font-size = 13
  font-weight = 500
  white-space = "nowrap"
  cursor = "pointer"
  transition = "background-color 180ms cubic-bezier(0.4, 0, 0.2, 1), color 180ms cubic-bezier(0.4, 0, 0.2, 1), box-shadow 180ms cubic-bezier(0.4, 0, 0.2, 1)"
  // Hover draws a ring and leaves the colours alone, so it never undoes the
  // picked segment's white.
  :hover
    box-shadow = "inset 0 0 0 1px rgba(255, 255, 255, 0.22)"
  :checked
    background-color = "#e6edf3"
    color = "#0b0f14"
    box-shadow = "0 1px 2px rgba(0, 0, 0, 0.5)"
  :focus-visible
    box-shadow = "0 0 0 2px #4aa8ff"

style Divider
  width = 1
  height = 20
  background-color = "rgba(255, 255, 255, 0.22)"
  margin = "0 4px"
  flex-shrink = 0

style Secondary
  color = "#9aa4ae"

style Mono
  font-family = "ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace"

style MathFont
  font-family = "ui-serif, 'Iowan Old Style', Georgia, 'Times New Roman', serif"

style Eyebrow
  font-family = "ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace"
  font-size = 12
  font-weight = 500
  letter-spacing = 0.5
  text-transform = "uppercase"
  color = "#9aa4ae"

style Para
  font-size = 15
  line-height = 1.55

style Disclosure
  appearance = "none"
  display = "flex"
  flex-direction = "row"
  align-items = "center"
  gap = 10
  min-height = 44
  padding = "0 4px"
  border-radius = 6
  background-color = "transparent"
  color = "#e6edf3"
  font-size = 15
  font-weight = 500
  cursor = "pointer"
  :hover
    background-color = "rgba(255, 255, 255, 0.08)"
  :focus-visible
    box-shadow = "0 0 0 2px #4aa8ff"

// A segment of the level switch: the sliding thumb behind it shows which is on.
style LevelSeg
  appearance = "none"
  position = "relative"
  flex = 1
  display = "flex"
  align-items = "center"
  justify-content = "center"
  padding = "0 8px"
  border-radius = 6
  background-color = "transparent"
  color = "#9aa4ae"
  font-size = 13
  font-weight = 500
  white-space = "nowrap"
  cursor = "pointer"
  transition = "color 240ms cubic-bezier(0.2, 0, 0, 1)"
  :hover
    color = "#e6edf3"
  :focus-visible
    box-shadow = "0 0 0 2px #4aa8ff"

style Well
  display = "flex"
  flex-direction = "column"
  gap = 10
  padding = 12
  border-radius = 8
  background-color = "rgba(255, 255, 255, 0.06)"
  box-shadow = "inset 0 0 0 1px rgba(255, 255, 255, 0.10)"

// The explainer slides in from the right edge, and back out.
keyframes panelIn
  from opacity=0 translate="24px 0px"
keyframes panelOut
  to opacity=0 translate="24px 0px" animation-timing-function="ease-in"
keyframes fadeIn
  from opacity=0
keyframes rise
  from opacity=0 translate="0px 6px"

// One page, rendered at build time so its head (title, description and share
// image) is in the HTML that link previews read.
routes nav
  home "/" render=build

component Mandelbrot
  resource view = exactSurface("mandel") as shape View
  resource viewport = exactViewport() as shape Viewport
  resource levels = levels() as shape Level[] else empty()
  resource themes = themes() as shape Theme[] else empty()
  state theme = 0 persist
  state zoomOut = false
  state showBox = false
  state level = 0 persist
  state explainerOpen = false
  state sheet = 0
  state codeOpen = false
  state mathsOpen = false
  // The slider caps the iterations once the reader moves it, while its level shows.
  state steps = 12
  state stepsMoved = false
  state noGpu = false
  derive phone = viewport.width < 720
  derive still = viewport.prefersReducedMotion
  derive current = levels.at(level)
  derive capped = stepsMoved and level == 1 and (phone ? sheet > 0 : explainerOpen)
  task gpuCheck mount
    after(5000, checkGpu)
  action checkGpu
    noGpu = not view.presented
  action pick(out: bool)
    zoomOut = out
  action toggleBox
    showBox = not showBox
  action setTheme(n: number)
    theme = n
  action reset
    postMessage("reset", "mandel")
  action hovered(on: bool)
    if not on
      postMessage("hover-off", "mandel")
  action pickLevel(n: number)
    level = n
  action toggleExplainer
    explainerOpen = not explainerOpen
  action setSheet(h: number)
    sheet = h
  action toggleCode
    codeOpen = not codeOpen
  action toggleMaths
    mathsOpen = not mathsOpen
  action resetSteps
    steps = 12
    stepsMoved = false
  action setSteps(v: number)
    steps = v
    stepsMoved = true
  action key(k: string)
    if k == "e" or k == "E"
      explainerOpen = not explainerOpen
    if k == "+" or k == "="
      postMessage("zoom-in", "mandel")
    if k == "-" or k == "_"
      postMessage("zoom-out", "mandel")
    if k == "ArrowLeft"
      postMessage("pan 80 0", "mandel")
    if k == "ArrowRight"
      postMessage("pan -80 0", "mandel")
    if k == "ArrowUp"
      postMessage("pan 0 80", "mandel")
    if k == "ArrowDown"
      postMessage("pan 0 -80", "mandel")
  view
    main testId="root" width="100%" height="100%" position="relative" overflow="hidden" background-color="#000000" color="#e6edf3" color-scheme="dark" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" key=key
      head title="Mandelbrot" description="Zoom deep into the Mandelbrot set, and learn how one simple rule makes it." image="assets/og.png" canonical="/"
      canvas surface=mandel(maxIter=(capped ? steps : 0), zoomOut=zoomOut, iterScale=1, bla=true, hoverBox=showBox, freeRight=((not phone and explainerOpen) ? 432 : 0), theme=theme) hover=hovered cursor=(zoomOut ? "zoom-out" : "zoom-in") position="absolute" inset=0 width="100%" height="100%" aria-label="The Mandelbrot set" role="img" testId="set"
      if noGpu
        NoGpu(levels=levels, level=level, pickLevel=pickLevel, codeOpen=codeOpen, mathsOpen=mathsOpen, toggleCode=toggleCode, toggleMaths=toggleMaths, phone=phone, still=still)
      else if phone
        PhoneUi(view=view, height=viewport.height, levels=levels, level=level, pickLevel=pickLevel, zoomOut=zoomOut, pick=pick, showBox=showBox, toggleBox=toggleBox, themes=themes, theme=theme, setTheme=setTheme, reset=reset, sheet=sheet, setSheet=setSheet, codeOpen=codeOpen, mathsOpen=mathsOpen, toggleCode=toggleCode, toggleMaths=toggleMaths, steps=steps, stepsMoved=stepsMoved, setSteps=setSteps, resetSteps=resetSteps, still=still)
      else
        column class=Glass position="absolute" left=16 bottom=16 testId="explore"
          row align-items="center" gap=4 padding=6
            row gap=2 padding=2 border-radius=8 background-color="rgba(255, 255, 255, 0.06)" box-shadow="inset 0 0 0 1px rgba(255, 255, 255, 0.10)" role="radiogroup" aria-label="Click to"
              button class=Seg role="radio" aria-checked=(not zoomOut) press=pick(false) testId="mode-in"
                Icon(name="zoom-in", size=16)
                text "Zoom in"
              button class=Seg role="radio" aria-checked=zoomOut press=pick(true) testId="mode-out"
                Icon(name="zoom-out", size=16)
                text "Zoom out"
            view class=Divider
            row align-items="center" gap=8 height=32 padding="0 8px" min-width=168
              if view.sharp < 16
                Ring(passes=view.sharp)
              else
                view width=16 height=16 flex-shrink=0
              text "Zoom" class=Secondary font-size=13
              text `${view.zoomLabel}×` class=Mono font-size=13 font-weight=500 font-variant-numeric="tabular-nums" testId="zoom"
            view class=Divider
            button class=Btn press=reset testId="reset"
              Icon(name="reset", size=16)
              text "Reset"
            button class=Btn aria-pressed=(showBox ? "true" : "false") press=toggleBox testId="box"
              Icon(name="box", size=16)
              text "Zoom box"
            button class=Btn popovertarget="theme-menu" testId="colours"
              Icon(name="palette", size=16)
              text "Colours"
          ThemeMenu(themes=themes, theme=theme, setTheme=setTheme)
          if view.deepest
            text "This is the deepest zoom. The GPU's 32-bit numbers cannot go further, so zoom out or pan." font-size=12 line-height=1.3 padding="0 12px 8px" color="#ffb86b" role="status" testId="deepest"
          else
            text `Click zooms ${zoomOut ? "out" : "in"} 4×. Option-click or right-click zooms the other way.` class=Secondary font-size=12 line-height=1.3 padding="0 12px 8px"
          text (view.sharp < 16 ? `Sharpening: pass ${view.sharp + 1} of 16` : "") role="status" position="absolute" width=1 height=1 overflow="hidden" opacity=0
        if explainerOpen
          column class=Glass position="absolute" top=16 right=16 bottom=16 width=400 overflow="hidden" animation=(still ? "none" : "panelIn 260ms cubic-bezier(0.2, 0, 0, 1) both") testId="explainer"
            -exact-exit-animation="panelOut 180ms ease-in both"
            column gap=12 padding="12px 12px 12px 20px" border-bottom="1px solid rgba(255, 255, 255, 0.10)"
              row align-items="center" gap=4
                text "Why is it cool?" role="heading" aria-level=2 flex=1 font-size=17 font-weight=600 testId="explainer-title"
                button class=Btn press=toggleExplainer color="#9aa4ae" aria-keyshortcuts="E" testId="hide"
                  Icon(name="panel", size=16)
                  text "Hide"
                  text "E" class=Mono font-size=11 padding="0 5px" height=18 line-height="18px" border-radius=4 box-shadow="inset 0 0 0 1px rgba(255, 255, 255, 0.22)"
              LevelSwitch(levels=levels, level=level, pickLevel=pickLevel, tall=false, still=still)
            scroll flex=1 min-height=0 padding="20px 20px 24px"
              match current
                case some(lv)
                  LevelView(lv=lv, codeOpen=codeOpen, mathsOpen=mathsOpen, toggleCode=toggleCode, toggleMaths=toggleMaths, steps=steps, stepsMoved=stepsMoved, setSteps=setSteps, resetSteps=resetSteps, live=true, still=still)
                case none
                  text ""
        else
          row class=Glass position="absolute" top=16 right=16 padding=4 animation=(still ? "none" : "fadeIn 200ms 120ms ease-out both")
            button class=Btn height=36 padding="0 10px" press=toggleExplainer aria-keyshortcuts="E" testId="show"
              Icon(name="book", size=16)
              text "Why is it cool?"
              text "E" class=Mono font-size=11 padding="0 5px" height=18 line-height="18px" border-radius=4 box-shadow="inset 0 0 0 1px rgba(255, 255, 255, 0.22)" color="#9aa4ae"

// The Lucide icon of that name, in the current colour.
// The colour themes, a menu opened by the Colours button.
component ThemeMenu
  props
    themes: Theme[]
    theme: number
    setTheme: action
  view
    column id="theme-menu" popover="auto" role="menu" aria-label="Colours" class=Glass padding=6 gap=2 min-width=200 testId="theme-menu"
      for t in themes key=t.id
        button class=Btn justify-content="flex-start" gap=10 height=36 role="menuitemradio" aria-checked=(t.index == theme) press=setTheme(t.index) popovertarget="theme-menu" popovertargetaction="hide" testId=`theme-${t.id}`
          view width=40 height=14 border-radius=4 background-image=t.swatch box-shadow="inset 0 0 0 1px rgba(255, 255, 255, 0.15)" flex-shrink=0
          text t.name flex=1 text-align="left"
          if t.index == theme
            view display="flex" testId=`chosen-${t.id}`
              Icon(name="check", size=16)

component Icon
  props
    name: string
    size: number
  view
    svg width=size height=size viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0
      if name == "zoom-in" or name == "zoom-out"
        circle cx=11 cy=11 r=8
        path d="m21 21-4.35-4.35"
        path d="M8 11h6"
        if name == "zoom-in"
          path d="M11 8v6"
      if name == "palette"
        path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"
        circle cx=13.5 cy=6.5 r=0.5 fill="currentColor"
        circle cx=17.5 cy=10.5 r=0.5 fill="currentColor"
        circle cx=8.5 cy=7.5 r=0.5 fill="currentColor"
        circle cx=6.5 cy=12.5 r=0.5 fill="currentColor"
      if name == "check"
        path d="M20 6 9 17l-5-5"
      if name == "reset"
        path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"
        path d="M3 3v5h5"
      if name == "box"
        path d="M3 7V5a2 2 0 0 1 2-2h2"
        path d="M17 3h2a2 2 0 0 1 2 2v2"
        path d="M21 17v2a2 2 0 0 1-2 2h-2"
        path d="M7 21H5a2 2 0 0 1-2-2v-2"
      if name == "panel"
        rect x=3 y=3 width=18 height=18 rx=2
        path d="M15 3v18"
      if name == "book"
        path d="M12 7v14"
        path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"
      if name == "down"
        path d="m6 9 6 6 6-6"
      if name == "up"
        path d="m18 15-6-6-6 6"
      if name == "code"
        path d="m16 18 6-6-6-6"
        path d="m8 6-6 6 6 6"
      if name == "sigma"
        path d="M18 7V5a1 1 0 0 0-1-1H6.5a.5.5 0 0 0-.4.8l4.5 6a2 2 0 0 1 0 2.4l-4.5 6a.5.5 0 0 0 .4.8H17a1 1 0 0 0 1-1v-2"
      if name == "no-gpu"
        path d="M17 17H4a2 2 0 0 1-2-2V5c0-1.5 1-2 1-2"
        path d="M22 15V5a2 2 0 0 0-2-2H9"
        path d="M8 21h8M12 17v4M2 2l20 20"

// The sharpening ring: one sixteenth of the circle per pass.
component Ring
  props
    passes: number
  view
    svg width=16 height=16 viewBox="0 0 16 16" fill="none" flex-shrink=0 transform="rotate(-90deg)"
      circle cx=8 cy=8 r=6 stroke="rgba(255, 255, 255, 0.22)" stroke-width=2
      circle cx=8 cy=8 r=6 stroke="#e6edf3" stroke-width=2 stroke-dasharray="37.7" stroke-dashoffset=(37.7 * (1 - passes / 16)) transition="stroke-dashoffset 120ms linear"

// Prose with maths in serif italics, bold and inline code.
component Runs
  props
    runs: Run[]
  view
    for r in runs key=r.id
      if r.kind == "math"
        text r.text class=MathFont font-style="italic" font-size="1.07em"
      else if r.kind == "strong"
        text r.text font-weight=600
      else if r.kind == "code"
        text r.text class=Mono font-size="0.87em" background-color="rgba(255, 255, 255, 0.06)" border-radius=4 padding="2px 5px"
      else
        text r.text

// One level: its formula, its sections, its control, and the code and the
// maths facts where it has them.
component LevelView
  props
    lv: Level
    codeOpen: bool
    mathsOpen: bool
    toggleCode: action
    toggleMaths: action
    steps: number
    // Until the reader moves the slider, the picture keeps its full detail.
    stepsMoved: bool
    setSteps: action
    resetSteps: action
    live: bool
    still: bool
  view
    // Keyed by the level, so a new level is a new node and plays its entrance.
    for shown in [lv.id] key=shown
      article display="flex" flex-direction="column" gap=16 aria-label=lv.label animation=(still ? "none" : "rise 220ms cubic-bezier(0.2, 0, 0, 1) both") testId=`level-${lv.id}`
        if lv.formula != ""
          text lv.formula class=MathFont font-style="italic" font-size=(lv.formula.length > 12 ? 22 : 30) text-align="center" padding="14px 0" border-top="1px solid rgba(255, 255, 255, 0.10)" border-bottom="1px solid rgba(255, 255, 255, 0.10)"
        for sec in lv.sections key=sec.id
          column gap=10
            text sec.title role="heading" aria-level=3 font-size=15 font-weight=600
            for p in sec.paras key=p.id
              text class=Para
                Runs(runs=p.runs)
        if lv.control == "steps"
          column class=Well
            row justify-content="space-between" align-items="center" min-height=28
              text "Steps to try" font-size=13 font-weight=500
              row align-items="center" gap=6
                text (stepsMoved ? `${steps}` : "Full detail") class=Mono font-size=13 font-variant-numeric="tabular-nums" testId="steps-value"
                if stepsMoved
                  button class=Btn height=28 padding="0 8px" font-size=12 press=resetSteps aria-label="Reset the steps to full detail" testId="steps-reset"
                    Icon(name="reset", size=14)
                    text "Reset"
            input type="range" min=1 max=200 step=1 value=(stepsMoved ? steps : 200) accent-color="#e6edf3" input=setSteps disabled=(not live) aria-label="Steps to try" testId="steps"
            text (live ? "Few steps give a blobby outline. More steps carve the edge. Watch the picture change as you drag." : "Needs the live picture. You can still read on.") class=Secondary font-size=12 line-height=1.4
        if lv.code.length > 0
          column border-top="1px solid rgba(255, 255, 255, 0.10)"
            column border-bottom="1px solid rgba(255, 255, 255, 0.10)" padding-bottom=(codeOpen ? 16 : 0) gap=12
              button class=Disclosure press=toggleCode aria-expanded=codeOpen testId="code"
                row width=24 height=24 align-items="center" justify-content="center" border-radius=4 box-shadow="inset 0 0 0 1px rgba(255, 255, 255, 0.22)" class=Secondary
                  Icon(name="code", size=14)
                text (codeOpen ? "Hide the code" : "Show the code") flex=1 text-align="left"
                text lv.codeLang class=Mono font-size=12 color="#9aa4ae"
                row class=Secondary
                  Icon(name=(codeOpen ? "up" : "down"), size=16)
              if codeOpen
                column border-radius=8 background-color="#0f1318" box-shadow="inset 0 0 0 1px #1f242c" overflow="hidden"
                  row height=32 align-items="center" padding="0 12px" border-bottom="1px solid #1f242c"
                    text lv.codeFile class=Mono font-size=12 color="#9aa4ae"
                  column padding="12px 14px" overflow-x="auto"
                    for l in lv.code key=l.id
                      text class=Mono font-size=12.5 line-height=1.6 white-space="pre" min-height=20 padding-left=`${l.indent * 2}ch`
                        for r in l.runs key=r.id
                          if r.kind == "c"
                            text r.text color="#9aa4ae" font-style="italic"
                          else if r.kind == "k"
                            text r.text color="#ff9bd2"
                          else if r.kind == "n"
                            text r.text color="#ffd36b"
                          else if r.kind == "f"
                            text r.text color="#7cc4ff"
                          else
                            text r.text
        if lv.claims.length > 0
          column border-top="1px solid rgba(255, 255, 255, 0.10)"
            column border-bottom="1px solid rgba(255, 255, 255, 0.10)" padding-bottom=(mathsOpen ? 16 : 0) gap=12
              button class=Disclosure press=toggleMaths aria-expanded=mathsOpen testId="maths"
                row width=24 height=24 align-items="center" justify-content="center" border-radius=4 box-shadow="inset 0 0 0 1px rgba(255, 255, 255, 0.22)" class=Secondary
                  Icon(name="sigma", size=14)
                text (mathsOpen ? "Hide the maths" : "Show the maths") flex=1 text-align="left"
                text `${lv.claims.length} ${lv.claims.length == 1 ? "fact" : "facts"}` class=Mono font-size=12 color="#9aa4ae"
                row class=Secondary
                  Icon(name=(mathsOpen ? "up" : "down"), size=16)
              if mathsOpen
                column gap=14
                  for c in lv.claims key=c.id
                    row gap=8
                      text c.id.slice(1) class=Mono font-size=12 color="#9aa4ae" width=20 line-height=1.9 flex-shrink=0
                      column gap=4 flex=1 min-width=0
                        text font-weight=500 class=Para
                          Runs(runs=c.stmt)
                        text font-size=13 line-height=1.5 color="#9aa4ae"
                          Runs(runs=c.why)
                  text "Sources" class=Eyebrow
                  column gap=6
                    for s in lv.sources key=s.id
                      if s.href != ""
                        link href=s.href font-size=13 color="#4aa8ff" text-decoration="underline"
                          text s.text
                      else
                        text s.text font-size=13

// The three levels as one segmented control, with a thumb that slides to the
// level picked.
component LevelSwitch
  props
    levels: Level[]
    level: number
    pickLevel: action
    tall: bool
    still: bool
  view
    row position="relative" gap=0 padding=2 border-radius=8 background-color="rgba(255, 255, 255, 0.06)" box-shadow="inset 0 0 0 1px rgba(255, 255, 255, 0.10)" role="radiogroup" aria-label="Explain it"
      view position="absolute" top=2 bottom=2 left=2 width=`calc((100% - 4px) / ${max(levels.length, 1)})` border-radius=6 background-color="#e6edf3" box-shadow="0 1px 2px rgba(0, 0, 0, 0.5)" translate=`${level * 100}% 0px` transition=(still ? "none" : "translate 260ms cubic-bezier(0.2, 0, 0, 1)") aria-hidden="true"
      for lv in levels key=lv.id
        button class=LevelSeg height=(tall ? 40 : 30) role="radio" aria-checked=(lv.index == level) press=pickLevel(lv.index) testId=`pick-${lv.id}`
          // The picked label's colour is its own row, so hover cannot turn it white on the thumb.
          text lv.label color=(lv.index == level ? "#0b0f14" : "inherit") transition=(still ? "none" : "color 240ms cubic-bezier(0.2, 0, 0, 1)")

// The phone: a zoom chip, a dock of icon buttons, and the explainer as a sheet
// at three heights (0 peek, 1 half, 2 full).
component PhoneUi
  props
    view: View
    height: number
    levels: Level[]
    level: number
    pickLevel: action
    zoomOut: bool
    pick: action
    showBox: bool
    toggleBox: action
    themes: Theme[]
    theme: number
    setTheme: action
    reset: action
    sheet: number
    setSheet: action
    codeOpen: bool
    mathsOpen: bool
    toggleCode: action
    toggleMaths: action
    steps: number
    stepsMoved: bool
    setSteps: action
    resetSteps: action
    still: bool
  derive sheetHeight = sheet == 0 ? 76 : sheet == 1 ? 420 : min(772, height - 72)
  derive current = levels.at(level)
  view
    column class=Glass position="absolute" top=12 left=12 gap=4 padding="8px 12px 9px" testId="chip"
      row align-items="center" gap=8
        if view.sharp < 16
          Ring(passes=view.sharp)
        text "Zoom" class=Secondary font-size=13
        text `${view.zoomLabel}×` class=Mono font-size=13 font-weight=500 font-variant-numeric="tabular-nums" testId="zoom"
      if view.deepest
        text "Deepest zoom: zoom out or pan" font-size=12 color="#ffb86b" role="status" testId="deepest"
      else
        text `Tap zooms ${zoomOut ? "out" : "in"} 4×` class=Secondary font-size=12
    if sheet < 2
      row class=Glass position="absolute" left="50%" translate="-50% 0" bottom=(sheetHeight + 12) align-items="center" gap=4 padding=4 border-radius=14 testId="dock"
        row gap=2 padding=2 border-radius=10 background-color="rgba(255, 255, 255, 0.06)" role="radiogroup" aria-label="Tap to"
          button class=Seg width=44 height=40 padding=0 role="radio" aria-checked=(not zoomOut) press=pick(false) aria-label="Zoom in" testId="mode-in"
            Icon(name="zoom-in", size=20)
          button class=Seg width=44 height=40 padding=0 role="radio" aria-checked=zoomOut press=pick(true) aria-label="Zoom out" testId="mode-out"
            Icon(name="zoom-out", size=20)
        view class=Divider
        button class=Btn width=44 height=44 padding=0 press=reset aria-label="Reset" testId="reset"
          Icon(name="reset", size=20)
        button class=Btn width=44 height=44 padding=0 aria-pressed=(showBox ? "true" : "false") press=toggleBox aria-label="Zoom box" testId="box"
          Icon(name="box", size=20)
        button class=Btn width=44 height=44 padding=0 popovertarget="theme-menu" aria-label="Colours" testId="colours"
          Icon(name="palette", size=20)
    ThemeMenu(themes=themes, theme=theme, setTheme=setTheme)
    column class=Glass position="absolute" left=0 right=0 bottom=0 height=sheetHeight border-radius="16px 16px 0 0" overflow="hidden" transition=(still ? "none" : "height 180ms cubic-bezier(0.4, 0, 0.2, 1)") testId="sheet"
      button appearance="none" height=20 background-color="transparent" display="flex" justify-content="center" press=setSheet(sheet == 1 ? 2 : 1) aria-label=(sheet == 1 ? "Expand the explainer" : "Open the explainer") testId="grab"
        view width=36 height=5 border-radius=3 margin-top=6 background-color="rgba(255, 255, 255, 0.22)"
      if sheet == 0
        button appearance="none" background-color="transparent" color="#e6edf3" display="flex" flex-direction="row" align-items="center" gap=8 padding="0 16px" min-height=44 text-align="left" press=setSheet(1) testId="peek"
          column flex=1 gap=4
            text "Explain it" class=Eyebrow
            text "Why is it cool?" font-size=17 font-weight=600
          Icon(name="up", size=20)
      else
        row align-items="center" gap=4 padding="0 8px 0 16px" min-height=52
          text "Why is it cool?" role="heading" aria-level=2 flex=1 font-size=17 font-weight=600 testId="explainer-title"
          button class=Btn width=44 height=44 padding=0 press=setSheet(0) aria-label="Collapse the explainer" testId="collapse"
            Icon(name="down", size=20)
        column padding="0 16px 8px"
          LevelSwitch(levels=levels, level=level, pickLevel=pickLevel, tall=true, still=still)
        scroll flex=1 min-height=0 padding="8px 16px 24px"
          match current
            case some(lv)
              LevelView(lv=lv, codeOpen=codeOpen, mathsOpen=mathsOpen, toggleCode=toggleCode, toggleMaths=toggleMaths, steps=steps, stepsMoved=stepsMoved, setSteps=setSteps, resetSteps=resetSteps, live=true, still=still)
            case none
              text ""

// Without WebGPU the page is for reading: the explainer beside a notice, and
// the controls that need the picture disabled.
component NoGpu
  props
    levels: Level[]
    level: number
    pickLevel: action
    codeOpen: bool
    mathsOpen: bool
    toggleCode: action
    toggleMaths: action
    phone: bool
    still: bool
  derive current = levels.at(level)
  view
    scroll position="absolute" inset=0 background-color="#0b0f14" testId="reader"
      row justify-content="center" padding=(phone ? "16px" : "40px 24px")
        column flex=1 max-width=640 min-width=0 gap=20
          row gap=12 align-items="flex-start" padding="14px 16px" border-radius=12 background-color="#161a20" box-shadow="inset 0 0 0 1px #30363d" testId="no-webgpu"
            row width=32 height=32 flex-shrink=0 align-items="center" justify-content="center" border-radius=8 background-color="rgba(33, 136, 255, 0.18)" color="#4aa8ff"
              Icon(name="no-gpu", size=18)
            column gap=4 flex=1
              text "This browser can’t draw the live picture" role="heading" aria-level=2 font-size=15 font-weight=600
              text "The live picture needs WebGPU. Try a recent version of Chrome or Edge on a desktop computer. Everything else on this page still works: the text, the code and the maths." class=Secondary font-size=13 line-height=1.5
          text "Why is it cool?" role="heading" aria-level=1 font-size=26 font-weight=600 letter-spacing=-0.4
          LevelSwitch(levels=levels, level=level, pickLevel=pickLevel, tall=false, still=still)
          match current
            case some(lv)
              LevelView(lv=lv, codeOpen=codeOpen, mathsOpen=mathsOpen, toggleCode=toggleCode, toggleMaths=toggleMaths, steps=12, stepsMoved=false, setSteps=pickLevel, resetSteps=toggleCode, live=false, still=still)
            case none
              text ""
